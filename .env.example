# Copy this file to .env, then replace the values.
# Private-key paths are relative to the project directory.
# Optional output paths (defaults: logs/ and backups/ inside the project):
# BACKUP_LOG_DIR=/root/Backup/logs
# BACKUP_OUTPUT_DIR=/root/Backup/backups

PG_PRODUCTION_HOST=10.11.5.4
PG_PRODUCTION_PORT=5432
PG_PRODUCTION_USER=YOUR_USER
PG_PRODUCTION_PASSWORD='YOUR_PASSWORD'
PG_PRODUCTION_DATABASES=postgres,userdb
PG_PRODUCTION_SSLMODE=prefer
PG_PRODUCTION_CONNECT_TIMEOUT=30
PG_PRODUCTION_DUMP_TIMEOUT=21600
# Optional per-connection executable (takes priority over PG_DUMP_PATH):
# PG_PRODUCTION_PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump
# Full executable path, required for PostgreSQL; pg_restore must be beside it.
PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump

# Add a second host by using another connection name:
# PG_ANALYTICS_HOST=10.11.5.5
# PG_ANALYTICS_PORT=5432
# PG_ANALYTICS_USER=YOUR_USER
# PG_ANALYTICS_PASSWORD='YOUR_PASSWORD'
# PG_ANALYTICS_DATABASES=analytics

SNOWFLAKE_ACCOUNT=YOUR_ACCOUNT
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE
SNOWFLAKE_ROLE=YOUR_ROLE
SNOWFLAKE_PRIVATE_KEY_FILE=secret/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSWORD=''
SNOWFLAKE_DATABASES=BRONZE,SILVER
SNOWFLAKE_CONNECT_TIMEOUT=30
SNOWFLAKE_QUERY_TIMEOUT=3600

OBS_ENDPOINT=https://obs.af-north-1.myhuaweicloud.com
OBS_BUCKET=metadata-daily-backups
OBS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
OBS_SECRET_ACCESS_KEY='YOUR_SECRET_KEY'
OBS_TIMEOUT=60
OBS_MULTIPART_THRESHOLD_MB=100
OBS_PART_SIZE_MB=64
OBS_UPLOAD_THREADS=2
OBS_ATTEMPTS=3
