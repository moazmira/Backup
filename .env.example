PG_HOST=your-postgres-host
PG_PORT=5432
PG_USER=your-postgres-user
PG_PASSWORD=your-postgres-password
PG_DATABASES=postgres,another_database
PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump

OBS_BUCKET=metadata-daily-backups
OBS_ENDPOINT=https://obs.af-north-1.myhuaweicloud.com
OBS_ACCESS_KEY_ID=your-access-key-id
OBS_SECRET_ACCESS_KEY=your-secret-access-key

# Snowflake backup: python main.py --source snowflake
# Comma-separated exact database names, following existing PG_DATABASES convention.
SNOWFLAKE_DATABASES=BRONZE,SILVER
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-user
SNOWFLAKE_ROLE=your-backup-role
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_PRIVATE_KEY_FILE=/absolute/path/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSWORD=
# Alternatively clear PRIVATE_KEY_FILE and set PASSWORD, subject to account MFA policy.
SNOWFLAKE_PASSWORD=
